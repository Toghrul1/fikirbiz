# FikirBiz Backend — Environment Example
# Bu faylı .env olaraq kopyalayın və real dəyərləri doldurun.
# HEÇ VAXT real secret-ları bu fayla yazmayın və commit etməyin.

DATABASE_URL=sqlite+aiosqlite:///./fikirbiz.db
JWT_SECRET=change-me-in-production
DEBUG=false

# İlk admin hesabı (yeni/boş bazada admin panelini açır).
# Bootstrap HƏR startup-da işləyir, amma mövcud hesabın şifrəsini EZİLMİR —
# yalnız bu e-poçtla hesab YOXDURSA yaradılır.
# Şifrə tələbləri: 8+ simvol, bir böyük hərf, bir rəqəm, bir xüsusi simvol.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Mistral AI (ensemble üçün)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Cloudflare Workers AI (FLUX.1 schnell image generation)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
FREE_IMAGE_GENERATIONS_PER_DAY=5

# Canva Connect API
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:8000/api/auth/canva/callback

# Frontend/Backend
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
